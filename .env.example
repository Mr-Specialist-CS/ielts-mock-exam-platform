# ADMIN PANEL CREDENTIALS (Cloudflare Worker Secrets):
# In production, set these via Wrangler secrets:
#   npx wrangler secret put ADMIN_USERNAME
#   npx wrangler secret put ADMIN_PASSWORD
ADMIN_USERNAME="YOUR_ADMIN_USERNAME"
ADMIN_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"

# OPTIONAL AI EVALUATION:
# Gemini AI key for automated writing grading:
#   npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# READING DOC-IMPORT (separate key, import only — no fallback to GEMINI_API_KEY):
# Local: add GEMINI_IMPORT_API_KEY to .env (gitignored). Prod:
#   npx wrangler secret put GEMINI_IMPORT_API_KEY
GEMINI_IMPORT_API_KEY="YOUR_GEMINI_IMPORT_API_KEY"

# APPLICATION DOMAIN & CORS:
# The primary production URL of your application
APP_URL="https://ieltsgate.example.com"
# Optional comma-separated list of allowed cross-origin origins
ALLOWED_ORIGINS="https://ieltsgate.example.com,https://ieltsgate-prod.pages.dev"

# LOCAL DEVELOPMENT & TESTING FLAGS (Do NOT enable in production):
# ALLOW_MEMORY_STORAGE: set to "true" ONLY for offline local Node/Vite development without D1
ALLOW_MEMORY_STORAGE="false"
# SEED_DEMO_DATA: set to "true" ONLY for pre-populating mock candidate sessions in development
SEED_DEMO_DATA="false"

